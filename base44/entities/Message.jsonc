{
  "name": "Message",
  "type": "object",
  "properties": {
    "booking_request_id": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "customer",
        "cook"
      ]
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "booking_request_id",
    "sender_email",
    "content"
  ],
  "rls": {
    "create": {
      "data.sender_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.booking_request_id": {
            "_filter": {
              "entities": "BookingRequest",
              "query": {
                "$or": [
                  {
                    "data.customer_email": "{{user.email}}"
                  },
                  {
                    "data.cook_email": "{{user.email}}"
                  }
                ]
              }
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}